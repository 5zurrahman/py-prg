s=input("Enter the password: ")
up=0
lw=0
sp=0
dg=0
if len(s)>7:
    for i in s:
        if i.isupper():
            up+=1
        elif i.islower():
            lw+=1
        elif i.isdigit():
            dg+=1
        else:
            sp+=1
    if up and lw and sp and dg >0:
        print("STRONG PASSWORD")
    else:
        print("WEAK PASSWORD")
else:
    print("password must have minimun 8 char")
